{
  "appBase": "http://localhost:5173",
  "webhooks": {
    "n8nBase": "https://harmonylove.app.n8n.cloud/webhook",
    "leadDataFetch": "https://harmonylove.app.n8n.cloud/webhook/LeadDataFetch",
    "quoteBuilder": "https://harmonylove.app.n8n.cloud/webhook/QuoteBuilder",
    "pdfEngineGenerate": "https://weott-proposal-engine.onrender.com/generate"
  },
  "storage": {
    "sheetsMode": "nexus.sheetsMode",
    "quoteLead": "nexus.quoteLead"
  },
  "pages": {
    "home": { "path": "/", "openQuoteBuilder": "text=Quote Builder" },
    "leads": { "path": "/leads" },
    "forms": { "path": "/quote-builder" },
    "proposalDoc": { "path": "/proposal-doc" }
  },
  "quoteBuilderSteps": [
    {
      "n": 1,
      "id": "event-core",
      "label": "Event Core",
      "fields": [
        { "key": "source", "kind": "select", "label": "Source" },
        { "key": "vesselType", "kind": "multi-select", "label": "Vessel Type" },
        { "key": "eventType", "kind": "select", "label": "Event Type" },
        { "key": "quoteVersion", "kind": "native-select", "label": "Quote version" },
        { "key": "weeklyPeriod", "kind": "native-select", "label": "Weekly period" },
        { "key": "dayPeriod", "kind": "native-select", "label": "Day period" },
        { "key": "groupBracket", "kind": "native-select", "label": "Group bracket" },
        { "key": "keyItems", "kind": "text", "label": "Key Items" },
        { "key": "dateFlexible", "kind": "toggle", "label": "Date flexible" },
        { "key": "eventDate", "kind": "date", "label": "Date of Event" },
        { "key": "progressNotes", "kind": "textarea", "label": "Call / progress notes" }
      ]
    },
    {
      "n": 2,
      "id": "guest-count",
      "label": "Guest Count",
      "fields": [
        { "key": "guestCount", "kind": "number", "label": "Guests (quote / lower)" },
        { "key": "guestCountHigh", "kind": "number", "label": "Guests high" },
        { "key": "noOfTables", "kind": "number", "label": "No. of tables" }
      ]
    },
    {
      "n": 3,
      "id": "schedule",
      "label": "Schedule Timings",
      "fields": [
        { "key": "embarkation", "kind": "time", "label": "Embarkation" },
        { "key": "departure", "kind": "time", "label": "Departure" },
        { "key": "returnTime", "kind": "time", "label": "Return" },
        { "key": "disembarkation", "kind": "time", "label": "Disembarkation" }
      ]
    },
    {
      "n": 4,
      "id": "catering",
      "label": "Catering",
      "fields": [
        { "key": "menuType", "kind": "menu-grouped", "label": "Menu Type" }
      ]
    },
    {
      "n": 5,
      "id": "cost-lines",
      "label": "Cost Lines",
      "fields": [
        { "key": "selectedLineIds", "kind": "cost-line-toggles", "label": "YES lines" },
        { "key": "bespokeLines", "kind": "bespoke", "label": "Bespoke 1-4" }
      ]
    },
    {
      "n": 6,
      "id": "financials",
      "label": "Financials",
      "fields": [
        { "key": "repeatClient", "kind": "toggle", "label": "Repeat Client" },
        { "key": "agentReferral", "kind": "toggle", "label": "Agent Referral" },
        { "key": "marginPercent", "kind": "number", "label": "Margin %" },
        { "key": "discountPercent", "kind": "number", "label": "Discount %" },
        { "key": "commissionPercent", "kind": "number", "label": "Commission %" },
        { "key": "totalCost", "kind": "number", "label": "Base Cost" },
        { "key": "packageWordingNotes", "kind": "textarea", "label": "Package wording" }
      ]
    },
    {
      "n": 7,
      "id": "cost-approval",
      "label": "Cost Approval",
      "fields": [
        { "key": "viewQuoteDetails", "kind": "button", "label": "View quote details" },
        { "key": "costApproved", "kind": "approve-button", "label": "Approve cost cross-check" }
      ]
    },
    {
      "n": 8,
      "id": "proposal-pack",
      "label": "Proposal Pack",
      "fields": [
        { "key": "proposalCategory", "kind": "category", "label": "corporate|wedding" },
        { "key": "templateId", "kind": "native-select", "label": "Select template" },
        { "key": "requiresInserts", "kind": "toggle", "label": "Requires inserts" },
        { "key": "selectedInserts", "kind": "insert-toggles", "label": "Inserts" }
      ]
    }
  ],
  "nav": {
    "next": "[data-testid=btn-next]",
    "generate": "[data-testid=btn-generate]",
    "back": "text=Back",
    "stepTab": "[data-testid=step-tab-{n}]"
  }
}
