# Six-digit team PIN checked only on this engine. Default is 945762 if unset.
NEXUS_TEAM_PASSWORD=945762

# Optional. If unset, a random secret is generated at process boot (sessions
# reset on deploy). Render sets this via generateValue in render.yaml.
NEXUS_AUTH_SECRET=

# Optional comma-separated SPA origins allowed to call this engine.
# NEXUS_CORS_ORIGINS=https://example.com
